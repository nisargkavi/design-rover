{
  "name": "design-rover-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "bun run --filter design-rover build",
    "pack:cli": "bun run build && bun pm pack --cwd packages/cli --destination ../..",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "dev:cli": "bun run --filter design-rover dev",
    "dev:web": "bun run --filter @design-rover/web dev",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "design-rover": "tsx packages/cli/src/bin.ts"
  },
  "devDependencies": {
    "@design-rover/core": "workspace:*",
    "@design-rover/model": "workspace:*",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ]
}
