{
  "name": "design-rover",
  "version": "0.3.3",
  "description": "Repository design knowledge for people and AI agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nisargkavi/design-rover.git",
    "directory": "packages/cli"
  },
  "bin": {
    "design-rover": "./dist/bin.js"
  },
  "files": [
