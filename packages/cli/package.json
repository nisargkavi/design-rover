    "ignore": "^7.0.5",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.2",
    "zod": "^4.1.5",
    "postcss": "^8.5.28"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "@design-rover/core": "workspace:*",
    "@design-rover/model": "workspace:*",
    "@design-rover/integrations": "workspace:*",
    "@design-rover/mcp": "workspace:*"
  },
  "exports": {
    "./cli": "./dist/bin.js"
  }
