  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
