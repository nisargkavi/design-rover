{
  "name": "design-rover-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "bun run --filter design-rover build",
    "pack:cli": "bun run build && node scripts/pack-cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "dev:cli": "bun run --filter design-rover dev",
    "dev:web": "bun run --filter @design-rover/web dev",
    "docs:dev": "bun run --filter @design-rover/docs dev",
    "docs:build": "bun run --filter @design-rover/docs build",
    "docs:check": "bun run --filter @design-rover/docs check",
    "docs:preview": "bun run --filter @design-rover/docs preview",
    "docs:verify": "node scripts/check-docs.mjs",
    "docs:test": "vitest run tests/docs-exports.test.ts --maxWorkers 2",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "design-rover": "tsx packages/cli/src/bin.ts",
    "test:scripts": "node --test scripts/*.test.mjs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@design-rover/core": "workspace:*",
    "@design-rover/model": "workspace:*",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "^24.5.2",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "semantic-release": "25.0.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ]
}
